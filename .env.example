# Copy to .env and fill in values. NEVER commit .env.
#   cp .env.example .env

# ── Application ─────────────────────────────────────────
# APP_ENV: development | test | production
APP_ENV=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: json | console
LOG_FORMAT=json

# ── Execution safety ────────────────────────────────────
# Allowed values: disabled | paper
# There is intentionally NO "live" value. Real-money execution is blocked
# in code and cannot be enabled through configuration.
TRADING_MODE=disabled

# ── PostgreSQL (used by docker-compose and the app) ────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant
POSTGRES_USER=quant
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── Market data providers (Phase 2+, leave empty for now) ─
# yfinance needs no key (prototyping only).
# MASSIVE_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# FMP_API_KEY=
# FRED_API_KEY=

# ── Alerts (Phase 14, optional) ─────────────────────────
# Generic JSON webhook for alert delivery; leave unset to keep alerts local only.
# The URL may contain a token: it is never logged or stored.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_MIN_SEVERITY=WARNING
